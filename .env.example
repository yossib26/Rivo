# העתיקו לקובץ בשם .env (הוא לא נכנס לגיט) ומלאו את הערכים
# מחרוזת החיבור מ-Neon: Dashboard > Connect (מומלץ הכתובת עם -pooler)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# מפתח סודי ל-HMAC של קודי OTP: מחרוזת אקראית ארוכה (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=
PORT=8000
# מצב הדגמה: מציג משתמשי דמה במסך הכניסה ומחזיר את קוד ה-OTP בתגובה (אין ספק SMS). לכבות (0) בסביבה אמיתית
DEMO_MODE=1
# כניסת Google מדומה (ללא OAuth אמיתי). לכבות (0) בסביבה אמיתית
ALLOW_MOCK_GOOGLE=1
